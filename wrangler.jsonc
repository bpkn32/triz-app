{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triz-app",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER_DO", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://citetic.com,https://triz-app-frontend.pages.dev"
  }
}
